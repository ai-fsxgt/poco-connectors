{
  "schema_version": 1,
  "platform_api_version": "1",
  "key": "dingtalk-notify",
  "package_version": "1.2.0",
  "authorization_contract_version": "1",
  "default_locale": "zh-CN",
  "locales": [
    "zh-CN",
    "en"
  ],
  "presentation": {
    "name_key": "name",
    "description_key": "description",
    "icon": "assets/icon.svg",
    "category": "信息通讯",
    "sections": [
      {
        "type": "notice",
        "title_key": "authorization.title",
        "description_key": "authorization.description"
      },
      {
        "type": "capability_list",
        "title_key": "capabilities.title",
        "items": [
          {
            "title_key": "capabilities.find.title",
            "description_key": "capabilities.find.description"
          },
          {
            "title_key": "capabilities.departments.title",
            "description_key": "capabilities.departments.description"
          },
          {
            "title_key": "capabilities.send.title",
            "description_key": "capabilities.send.description"
          },
          {
            "title_key": "capabilities.recall.title",
            "description_key": "capabilities.recall.description"
          },
          {
            "title_key": "capabilities.events.title",
            "description_key": "capabilities.events.description"
          }
        ]
      },
      {
        "type": "notice",
        "title_key": "limits.title",
        "description_key": "limits.description"
      },
      {
        "type": "example_list",
        "title_key": "examples.title",
        "items": [
          {
            "title_key": "examples.notice.title",
            "description_key": "examples.notice.description"
          },
          {
            "title_key": "examples.follow.title",
            "description_key": "examples.follow.description"
          }
        ]
      }
    ],
    "connection_actions": [
      {
        "type": "reauthorize",
        "label_key": "actions.reauthorize"
      }
    ]
  },
  "connection_policy": "multiple_per_user",
  "permission_key": "feature.connector.dingtalk-notify",
  "configuration": {
    "fields": []
  },
  "auth": {
    "strategy": "im_bot",
    "interaction": "form",
    "options": {
      "type": "im_bot",
      "platform": "dingtalk"
    }
  },
  "runtime": {
    "adapter": "program",
    "transport": "program",
    "options": {
      "type": "program"
    }
  },
  "program": {
    "protocol_version": 1,
    "runtime": "python",
    "entrypoint": "provider/main.py",
    "capabilities": []
  },
  "tool_policy": {
    "default": "deny",
    "rules": [
      {
        "tool": "find_users",
        "effect": "read",
        "retry": "safe"
      },
      {
        "tool": "find_user_by_mobile",
        "effect": "read",
        "retry": "safe"
      },
      {
        "tool": "find_departments",
        "effect": "read",
        "retry": "safe"
      },
      {
        "tool": "list_sub_departments",
        "effect": "read",
        "retry": "safe"
      },
      {
        "tool": "list_department_users",
        "effect": "read",
        "retry": "safe"
      },
      {
        "tool": "send_message",
        "effect": "write",
        "retry": "never",
        "confirmation": "user_required"
      },
      {
        "tool": "recall_message",
        "effect": "destructive",
        "retry": "never",
        "confirmation": "user_required"
      },
      {
        "tool": "list_message_events",
        "effect": "read",
        "retry": "safe"
      }
    ]
  },
  "skills": [
    {
      "key": "dingtalk-notify",
      "path": "skills/dingtalk-notify"
    }
  ]
}
