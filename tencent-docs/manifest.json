{
  "schema_version": 1,
  "platform_api_version": "1",
  "key": "tencent-docs",
  "package_version": "1.1.0",
  "authorization_contract_version": "2",
  "default_locale": "zh-CN",
  "locales": [
    "zh-CN",
    "en"
  ],
  "presentation": {
    "name_key": "name",
    "description_key": "description",
    "icon": "assets/icon.svg",
    "category": "productivity",
    "sections": [
      {
        "type": "notice",
        "title_key": "authorization.title",
        "description_key": "authorization.description"
      },
      {
        "type": "capability_list",
        "title_key": "capabilities.title",
        "items": [
          {
            "title_key": "capabilities.documents.title",
            "description_key": "capabilities.documents.description"
          },
          {
            "title_key": "capabilities.tables.title",
            "description_key": "capabilities.tables.description"
          },
          {
            "title_key": "capabilities.files.title",
            "description_key": "capabilities.files.description"
          },
          {
            "title_key": "capabilities.safety.title",
            "description_key": "capabilities.safety.description"
          }
        ]
      },
      {
        "type": "help_links",
        "title_key": "help.title",
        "items": [
          {
            "title_key": "help.token.title",
            "url": "https://docs.qq.com/scenario/open-claw.html?nlc=1"
          }
        ]
      }
    ],
    "connection_actions": [
      {
        "type": "reauthorize",
        "label_key": "actions.reauthorize"
      },
      {
        "type": "open_service",
        "label_key": "actions.openService",
        "url": "https://docs.qq.com/home"
      }
    ]
  },
  "connection_policy": "single_per_user",
  "permission_key": "feature.connector.tencent-docs",
  "configuration": {
    "fields": []
  },
  "auth": {
    "strategy": "static_credentials",
    "interaction": "form",
    "fields": [
      {
        "key": "token",
        "type": "secret",
        "label_key": "authorization.token.label",
        "description_key": "authorization.token.description",
        "placeholder_key": "authorization.token.placeholder",
        "required": true,
        "min_length": 1,
        "max_length": 16384
      }
    ],
    "options": {
      "type": "static_credentials",
      "verification": "mcp_initialize_and_list_tools",
      "account_identity": "connection_id"
    }
  },
  "runtime": {
    "adapter": "remote_mcp",
    "transport": "streamable_http",
    "options": {
      "type": "remote_mcp",
      "servers": [
        {
          "key": "tencent-docs",
          "endpoint": {
            "url": "https://docs.qq.com/openapi/mcp"
          }
        },
        {
          "key": "slide-mcp",
          "endpoint": {
            "url": "https://docs.qq.com/api/v6/slide/mcp"
          }
        },
        {
          "key": "doc-mcp",
          "endpoint": {
            "url": "https://docs.qq.com/api/v6/doc/mcp"
          }
        },
        {
          "key": "sheet-mcp",
          "endpoint": {
            "url": "https://docs.qq.com/api/v6/sheet/mcp"
          }
        }
      ],
      "credential_binding": {
        "type": "http_header",
        "name": "Authorization",
        "credential_field": "token"
      }
    }
  },
